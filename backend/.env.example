# DocQA Backend — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit the real .env file to version control.

# --- Required API Keys ---
GROQ_API_KEY=gsk_your_groq_api_key_here
VOYAGE_API_KEY=pa-your_voyage_api_key_here

# --- Optional Overrides (defaults shown) ---
# UPLOAD_DIR=uploads
# CHROMA_PERSIST_DIR=chroma_db
# EMBEDDING_MODEL=voyage-4-lite        # or voyage-4 / voyage-4-large for better quality
# GENERATION_MODEL=llama-3.3-70b-versatile
# GENERATION_TEMPERATURE=0.1
# RETRIEVAL_K=5
